# Persistent local Moodle test instance. Do not use these values in production.
OTA_IMAGE=ota-moodle:test
WWWROOT=http://localhost:8082
SITE_FULLNAME=OTA Moodle Test
SITE_SHORTNAME=OTA Test
ADMIN_USER=admin
ADMIN_PASS=Admin123!Test
ADMIN_EMAIL=admin@example.test
MOODLE_PASSWORD_SALT_MAIN=change-this-to-a-long-random-test-secret

# Mount any Moodle plugin into the shared test instance.
TEST_PLUGIN_PATH=/absolute/path/to/a/moodle-plugin
TEST_PLUGIN_TARGET=public/blocks/example
