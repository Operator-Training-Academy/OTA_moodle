# GHCR image selection for PHP, Apache, extensions, and the Moodle source seed.
# Pin a published infrastructure release tag in production.
MOODLE_IMAGE=ghcr.io/prevail90/ota_moodle
MOODLE_TAG=latest

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=replace-with-a-database-secret
DB_PREFIX=mdl_

# Moodle installation
WWWROOT=https://moodle.example.com
SITE_FULLNAME=Hardened Moodle
SITE_SHORTNAME=Moodle
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com
# Generate once with: openssl rand -hex 32
MOODLE_PASSWORD_SALT_MAIN=replace-with-a-persistent-random-secret

# Networks and storage
PROXY_NETWORK=nginx-proxy-manager
DB_NETWORK=postgres-net
MOODLEDATA_PATH=./moodledata
MOODLE_CODE_PATH=./moodle

# Optional runtime configuration
TZ=UTC
REVERSE_PROXY=true
SSL_PROXY=true
REDIS_PREFIX=moodle_
