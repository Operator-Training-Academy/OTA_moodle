# GHCR image tag for PHP, Apache, extensions, and the Moodle source seed.
# The image URL is defined by docker-compose.yml. Pin a release tag in production.
OTA_IMAGE_TAG=latest

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=replace-with-a-database-secret
DB_PREFIX=mdl_

# Moodle installation
WWWROOT=https://moodle.example.com
SITE_FULLNAME=Hardened Moodle
SITE_SHORTNAME=Moodle
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com
# Generate once with: openssl rand -hex 32
MOODLE_PASSWORD_SALT_MAIN=replace-with-a-persistent-random-secret

# Networks and storage. These host paths mount to /var/www/moodle and /moodledata.
PROXY_NETWORK=nginx-proxy-manager
DB_NETWORK=postgres-net
MOODLEDATA_PATH=./moodledata
MOODLE_CODE_PATH=./moodle

# Optional runtime configuration
TZ=UTC
REVERSE_PROXY=true
SSL_PROXY=true
REDIS_PREFIX=moodle_
